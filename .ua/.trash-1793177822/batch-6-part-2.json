   "name": "Credentials.java",
   "filePath": "src/main/java/exchangeserver/gateway/Credentials.java",
   "summary": "Immutable participant credential store backed by a users file of salted PBKDF2-HMAC-SHA256 hashes; verifies secrets in constant time and rewrites the file atomically when adding users.",
   "tags": [
    "security",
    "authentication",
    "pbkdf2",
    "credentials",
    "persistence"
   ],
   "complexity": "moderate",
   "languageNotes": "MessageDigest.isEqual gives a constant-time comparison; unknown users still pay a PBKDF2 cost to avoid a timing oracle."
  },
