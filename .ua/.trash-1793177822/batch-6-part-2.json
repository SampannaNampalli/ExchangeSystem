   "id": "file:src/main/java/exchangeserver/journal/JournalLock.java",
   "type": "file",
   "name": "JournalLock.java",
   "filePath": "src/main/java/exchangeserver/journal/JournalLock.java",
   "summary": "Per-journal exclusive ownership lock on a separate <journal>.lock file, guarding against both other processes (OS file lock) and a second acquire in the same JVM.",
   "tags": [
    "concurrency",
    "file-lock",
    "journal",
    "resource-management"
   ],
   "complexity": "moderate",
   "languageNotes": "POSIX file locks in Java are per-process and dropped when any handle on the file closes, which is why the lock lives on a dedicated file and a static in-JVM set refuses re-entrant acquires."
  },
