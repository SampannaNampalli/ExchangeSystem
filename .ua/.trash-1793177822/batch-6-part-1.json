   "id": "file:src/main/java/exchangeserver/Main.java",
   "type": "file",
   "name": "Main.java",
   "filePath": "src/main/java/exchangeserver/Main.java",
   "summary": "Command-line entry point that parses options, runs operator tools (--add-user, --quarantine, --compact), or loads credentials, binds the TCP/TLS gateway and starts the ExchangeService writer; maps failures to exit codes 0/1/2 with fail-stop on halt.",
   "tags": [
    "entry-point",
    "cli",
    "bootstrap",
    "operator-tools",
    "lifecycle"
   ],
   "complexity": "complex",
   "languageNotes": "Uses a shutdown hook that halts the process itself so a signal stop exits 0; exit code 2 signals a halted writer (fail-stop)."
  },
