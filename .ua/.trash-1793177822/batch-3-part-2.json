    "matching-engine",
    "core-domain",
    "determinism",
    "service",
    "risk-checks"
   ],
   "complexity": "complex",
   "languageNotes": "The outcome is an exhaustive switch over the OrderType enum with no default, so the compiler rejects a missed type."
  },
