  },
  {
   "id": "file:src/main/java/exchangeserver/engine/MatchingEngine.java",
   "type": "file",
   "name": "MatchingEngine.java",
   "filePath": "src/main/java/exchangeserver/engine/MatchingEngine.java",
   "summary": "Deterministic price-time-priority matching engine for one instrument: runs side-effect-free pre-checks (duplicate id, price band, caps, FOK fillability, post-only), the shared matching loop with self-trade prevention, and per-OrderType outcomes, delegating book mutations to OrderBook.",
