 "nodes": [
  {
   "id": "file:src/main/java/exchangeserver/gateway/ClientSession.java",
   "type": "file",
   "name": "ClientSession.java",
   "filePath": "src/main/java/exchangeserver/gateway/ClientSession.java",
   "summary": "One TCP client connection with a reader thread (parse, LOGIN authentication, stateless checks, in-flight cap and token-bucket rate limit) and a sender thread draining a bounded outbound queue; closes only after every handed-in request completes (D74-D76).",
   "tags": [
    "gateway",
    "networking",
    "session",
    "concurrency",
    "security"
   ],
   "complexity": "complex",
   "languageNotes": "Uses a String sentinel created with new String() and compared by identity, AtomicInteger in-flight tracking, and volatile fields for cross-thread handoff between reader, sender and the exchange writer."
  },
  {
   "id": "class:src/main/java/exchangeserver/gateway/ClientSession.java:ClientSession",
   "type": "class",
   "name": "ClientSession",
   "filePath": "src/main/java/exchangeserver/gateway/ClientSession.java",
   "lineRange": [
    53,
    475
   ],
   "summary": "Package-private per-connection session that bridges protocol lines to ExchangeService calls and never blocks the writer thread when sending (slow clients are disconnected, D54).",
