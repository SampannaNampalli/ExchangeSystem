   "id": "file:src/main/java/exchangeserver/core/Snapshot.java",
   "type": "file",
   "name": "Snapshot.java",
   "filePath": "src/main/java/exchangeserver/core/Snapshot.java",
   "summary": "Persistent exchange state after a given sequence number (D71): writes and reads the checksummed '<journal>.snapshot-<seq>' file of SNAPSHOT/ORDER/OSEQ/END records so recovery can start mid-history instead of replaying from sequence 1.",
   "tags": [
    "persistence",
    "serialization",
    "recovery",
    "snapshot",
    "validation"
   ],
   "complexity": "moderate",
   "languageNotes": "Package-private Java record with a compact canonical constructor that defensively copies collections; parsing is strict, rejecting any checksum, field-count or END-count mismatch."
  },
