  {
   "id": "file:src/main/java/exchangeserver/core/ExchangeService.java",
   "type": "file",
   "name": "ExchangeService.java",
   "filePath": "src/main/java/exchangeserver/core/ExchangeService.java",
   "summary": "Implements the single-writer thread model: any caller thread hands requests into one queue, and the dedicated 'exchange-writer' thread drains them in smart batches (or linger group-commit) and calls Exchange.process, journalling with one fsync per batch. Manages the RUNNING/STOPPING/STOPPED/HALTED lifecycle under one lock so no accepted request is ever lost.",
   "tags": [
    "service",
    "concurrency",
    "single-writer",
    "batching",
    "lifecycle"
   ],
   "complexity": "complex",
   "languageNotes": "Uses CompletableFuture hand-off (whenCompleteAsync) so callers never receive the writer's own future, and a stop-marker sentinel compared by identity to end the drain loop."
  },
  {
   "id": "class:src/main/java/exchangeserver/core/ExchangeService.java:ExchangeService",
   "type": "class",
   "name": "ExchangeService",
   "filePath": "src/main/java/exchangeserver/core/ExchangeService.java",
   "lineRange": [
    50,
    360
   ],
   "summary": "Owns the exchange-writer thread and the request queue; exposes future-based and callback-based submit/cancel/snapshot/cancelAll/attach/resend, enforces queue capacity under a lock, and halts cleanly on journal or writer failure.",
   "tags": [
    "service",
    "single-writer",
    "concurrency",
    "queue"
   ],
   "complexity": "complex"
  },
